rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function isSignedIn() { return request.auth != null && request.auth.token.role in ['SUPER_ADMIN','MANAGER','OPERATOR']; }
  function isSuperAdmin() { return request.auth != null && request.auth.token.role == 'SUPER_ADMIN'; }
  match /customers/{customerId} {
   allow read: if isSignedIn();
   allow create, update: if isSignedIn() && request.resource.data.shopName is string && request.resource.data.phoneE164 is string && request.resource.data.phoneE164.matches('^\\+[1-9]\\d{7,14}$');
   allow delete: if isSuperAdmin();
  }
  match /import_batches/{batchId} { allow read: if isSignedIn(); allow create, update: if isSignedIn(); allow delete: if isSuperAdmin(); }
  match /projects/{projectId} { allow read: if isSignedIn(); allow create, update: if isSignedIn(); allow delete: if isSuperAdmin(); }
  match /domains/{domainId} { allow read: if isSignedIn(); allow create, update: if isSignedIn(); allow delete: if isSuperAdmin(); }
  match /follow_ups/{taskId} { allow read: if isSignedIn(); allow create, update: if isSignedIn(); allow delete: if isSuperAdmin(); }
  match /audit_logs/{eventId} { allow read: if isSuperAdmin(); allow create: if isSignedIn(); allow update, delete: if false; }
  match /{document=**} { allow read, write: if false; }
 }
}